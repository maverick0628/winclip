<ui:FluentWindow x:Class="WinClip.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="WinClip Settings"
        Width="620" Height="720"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="{DynamicResource AppWindowBackground}">


    <Window.Resources>
        <!-- Toggle switch — Windows 11 geometry (40×20 track, 12px thumb, 14px on hover) -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="Track" Width="40" Height="20" CornerRadius="10"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource TextMutedBrush}"
                                    BorderThickness="1"
                                    Cursor="Hand">
                                <Border x:Name="Thumb" Width="12" Height="12" CornerRadius="6"
                                        Background="{DynamicResource TextMutedBrush}"
                                        HorizontalAlignment="Left"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="ThumbScale" ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentSolidBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentSolidBrush}"/>
                                <Setter TargetName="Thumb" Property="Background" Value="White"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.16" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.16" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Single Border clips content to rounded corners. DWM provides Mica backdrop + system shadow on Win11.
         Background stays transparent so Mica shows through the gaps between cards. -->
    <Border CornerRadius="8" ClipToBounds="True" Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Custom title bar -->
                <RowDefinition Height="Auto"/>  <!-- Search and sticky section -->
                <RowDefinition Height="*"/>     <!-- Content -->
            </Grid.RowDefinitions>

                <!-- WPF-UI TitleBar: native min/max/close, drag region, system menu — no manual chrome -->
                <ui:TitleBar Grid.Row="0"
                             Title="WinClip Settings"
                             ShowMaximize="False"
                             Padding="14,8,8,8"/>

                <StackPanel Grid.Row="1" Margin="20,0,20,12">
                    <TextBlock Text="Make WinClip yours" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <Grid>
                        <TextBox x:Name="SettingsSearch" Style="{StaticResource ModernTextBox}"
                                 AutomationProperties.Name="Search settings"
                                 TextChanged="SettingsSearch_TextChanged" Padding="12,9"/>
                        <TextBlock x:Name="SettingsSearchPlaceholder" Text="Search settings and actions…"
                                   Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </Grid>
                    <TextBlock x:Name="CurrentSection" Text="Preferences" Margin="0,12,0,0"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <ScrollViewer x:Name="SettingsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="20,4,20,20"
                              ScrollChanged="SettingsScroll_ScrollChanged">
                    <StackPanel x:Name="SettingsSections">
                        <!-- General Tab -->

                            <!-- Preferences card -->
                            <Border Tag="Preferences" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Preferences" Style="{StaticResource SectionTitle}"/>

                                    <!-- Sound toggle -->
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Sound effects" Style="{StaticResource ToggleLabel}"/>
                                            <TextBlock Text="Play a sound when actions are triggered"
                                                       TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="SoundToggle" Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Checked="SoundToggle_Changed" Unchecked="SoundToggle_Changed"/>
                                    </Grid>

                                    <!-- Startup toggle -->
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Start with Windows" Style="{StaticResource ToggleLabel}"/>
                                            <TextBlock Text="Launch WinClip when you sign in"
                                                       TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="StartupToggle" Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Checked="StartupToggle_Changed" Unchecked="StartupToggle_Changed"/>
                                    </Grid>

                                    <!-- Auto-copy toggle -->
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Auto-copy on drag select" Style="{StaticResource ToggleLabel}"/>
                                            <TextBlock Text="Automatically copy text when you drag to select it"
                                                       TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="AutoCopyToggle" Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Checked="AutoCopyToggle_Changed" Unchecked="AutoCopyToggle_Changed"/>
                                    </Grid>

                                    <!-- Text cursor gate -->
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Only pop up over text" Style="{StaticResource ToggleLabel}"/>
                                            <TextBlock Text="Ignore drags and double-clicks unless the pointer is a text cursor"
                                                       TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="TextCursorToggle" Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Checked="TextCursorToggle_Changed" Unchecked="TextCursorToggle_Changed"/>
                                    </Grid>

                                    <!-- Usage statistics toggle (opt-in, off by default) -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Share anonymous usage statistics" Style="{StaticResource ToggleLabel}"/>
                                            <TextBlock Text="Sends the name of each action you run and the WinClip version. Never your text."
                                                       TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="UsageStatsToggle" Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Checked="UsageStatsToggle_Changed" Unchecked="UsageStatsToggle_Changed"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Theme card -->
                            <Border Tag="Appearance" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Popup theme" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="ThemeCombo" Width="220" HorizontalAlignment="Left"
                                              Style="{StaticResource ModernCombo}"
                                              SelectionChanged="ThemeCombo_SelectionChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- Excluded processes card -->
                            <Border Tag="Excluded Apps" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Excluded Apps" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="WinClip won't activate in these applications"
                                               Style="{StaticResource SectionDesc}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBox x:Name="ExcludeProcessInput" Width="240"
                                                 Style="{StaticResource ModernTextBox}" Margin="0,0,8,0"/>
                                        <ui:Button Content="Add" Appearance="Secondary"
                                                Click="AddExcluded_Click"/>
                                    </StackPanel>
                                    <ItemsControl x:Name="ExcludedList" MaxHeight="120"/>
                                    <TextBlock x:Name="ProcessWarning"
                                               Visibility="Collapsed"
                                               Foreground="{DynamicResource WarningBrush}"
                                               FontSize="13"
                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- AI configuration card -->
                            <Border Tag="AI Features" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="AI Features" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Configure an AI provider to enable Grammar Check, Summarize, Rephrase, Expand, and Custom Prompt actions."
                                               Style="{StaticResource SectionDesc}"/>

                                    <!-- Provider dropdown -->
                                    <TextBlock Text="Provider" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="AIProviderCombo" Width="240" HorizontalAlignment="Left"
                                              Style="{StaticResource ModernCombo}" Margin="0,0,0,14"
                                              SelectionChanged="AIProviderCombo_SelectionChanged">
                                        <ComboBoxItem Content="None (disabled)" Tag=""/>
                                        <ComboBoxItem Content="OpenAI" Tag="openai"/>
                                        <ComboBoxItem Content="Claude (Anthropic)" Tag="claude"/>
                                        <ComboBoxItem Content="LM Studio (local)" Tag="lmstudio"/>
                                    </ComboBox>

                                    <!-- API Key -->
                                    <StackPanel x:Name="AIApiKeyPanel" Visibility="Collapsed">
                                        <TextBlock Text="API Key" Style="{StaticResource FieldLabel}"/>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="AIApiKeyInput" Grid.Column="0"
                                                     Style="{StaticResource ModernTextBox}"/>
                                            <ui:Button x:Name="AIToggleKeyBtn" Grid.Column="1" Content="Show"
                                                    Appearance="Secondary" Margin="8,0,0,0"
                                                    Click="AIToggleKey_Click"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Endpoint -->
                                    <StackPanel x:Name="AIEndpointPanel" Visibility="Collapsed">
                                        <TextBlock Text="Endpoint URL" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="AIEndpointInput"
                                                 Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>
                                    </StackPanel>

                                    <!-- Model override -->
                                    <StackPanel x:Name="AIModelPanel" Visibility="Collapsed">
                                        <TextBlock Text="Model (optional)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="AIModelInput"
                                                 Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>
                                    </StackPanel>

                                    <!-- Save button + status -->
                                    <StackPanel x:Name="AISavePanel" Visibility="Collapsed" Orientation="Horizontal" Margin="0,4,0,0">
                                        <ui:Button Content="Save AI Settings" Appearance="Primary"
                                                Click="AISave_Click"/>
                                        <TextBlock x:Name="AISaveStatus" FontSize="13"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"
                                                   Margin="12,0,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>


                        <!-- Actions Tab -->

                            <!-- Profile card -->
                            <Border Tag="Action Profile" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Action Profile" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Choose a preset or customize which actions appear"
                                               Style="{StaticResource SectionDesc}"/>
                                    <ComboBox x:Name="ProfileCombo" Width="220" HorizontalAlignment="Left"
                                              Style="{StaticResource ModernCombo}" Margin="0,0,0,8"
                                              SelectionChanged="ProfileCombo_SelectionChanged"/>
                                    <TextBlock x:Name="ActionCountText" FontSize="13"
                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Actions checklist card -->
                            <Border Tag="Enabled Actions" Style="{StaticResource Card}" Padding="24,20">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Enabled Actions" Style="{StaticResource SectionTitle}"
                                                   Margin="0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ui:Button Content="Select All" Appearance="Secondary"
                                                    Click="SelectAllActions_Click" Margin="0,0,6,0"
                                                    Padding="10,5" FontSize="11"/>
                                            <ui:Button Content="Unselect All" Appearance="Secondary"
                                                    Click="UnselectAllActions_Click"
                                                    Padding="10,5" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel x:Name="ActionCheckboxPanel"/>
                                </StackPanel>
                            </Border>


                        <!-- About Tab -->

                            <Border Tag="About WinClip" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="About WinClip" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock x:Name="VersionText" FontSize="15" FontWeight="SemiBold"
                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Smart clipboard actions for Windows"
                                               FontSize="13"
                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                                    <TextBlock FontSize="13" FontFamily="Segoe UI Variable Text, Segoe UI"
                                               Margin="0,0,0,8">
                                        <Hyperlink Click="Homepage_Click" Foreground="{DynamicResource AccentSolidBrush}"
                                                   TextDecorations="None">
                                            Homepage &#x2192;
                                        </Hyperlink>
                                    </TextBlock>

                                    <Border Height="1" Background="{DynamicResource BorderBrushToken}" Opacity="0.5" Margin="0,12,0,16"/>

                                    <TextBlock Text="Copyright 2025-2026 DST Digital, LLC. Released under the MIT licence." FontSize="11"
                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>

                    </StackPanel>
                </ScrollViewer>
        </Grid>
    </Border>
</ui:FluentWindow>
