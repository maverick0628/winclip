<Window x:Class="WinClip.UI.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinClip"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False">

    <Window.Resources>
        <!-- Action button: filled pill with themed bg, rounded rect -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer wrapper for shadow (Margin creates space for shadow to render) -->
    <Border Margin="8">
        <!-- Elevated shadow per DESIGN.md -->
        <Border.Effect>
            <DropShadowEffect ShadowDepth="2"
                              BlurRadius="16"
                              Color="#0F172A"
                              Opacity="0.12"
                              Direction="270"/>
        </Border.Effect>

        <!-- Main popup surface -->
        <Border x:Name="RootBorder"
                CornerRadius="12"
                Padding="10,8"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.Background>
                <LinearGradientBrush x:Name="RootBackgroundGradient" StartPoint="0,0" EndPoint="0,1">
                    <GradientStop x:Name="GradientStart" Color="#FFFFFF" Offset="0"/>
                    <GradientStop x:Name="GradientEnd" Color="#F8FAFC" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush x:Name="RootBorderBrush" Color="#E2E8F0"/>
            </Border.BorderBrush>
            <Border.BorderThickness>
                <Thickness>1</Thickness>
            </Border.BorderThickness>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Status icon -->
                <TextBlock x:Name="StatusIcon"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="4,0,5,0"
                           Opacity="0"
                           Text="&#x2713;"/>

                <TextBlock x:Name="StatusText"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="#64748B"
                           VerticalAlignment="Center"
                           MaxWidth="360"
                           TextTrimming="CharacterEllipsis"
                           Text="Copied"/>

                <!-- Separator -->
                <Border x:Name="Separator"
                        Width="1" Height="18"
                        Margin="8,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Opacity="0.3">
                    <Border.Background>
                        <SolidColorBrush x:Name="SeparatorBrush" Color="#E2E8F0"/>
                    </Border.Background>
                </Border>

                <!-- Copy button -->
                <Button x:Name="CopyButton"
                        Content="Copy"
                        Style="{StaticResource ActionBtn}"
                        Click="CopyButton_Click"
                        Visibility="Collapsed"/>

                <!-- Cut button -->
                <Button x:Name="CutButton"
                        Content="Cut"
                        Style="{StaticResource ActionBtn}"
                        Click="CutButton_Click"
                        Visibility="Collapsed"/>

                <!-- Separator 2 -->
                <Border x:Name="Separator2"
                        Width="1" Height="18"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Opacity="0.3">
                    <Border.Background>
                        <SolidColorBrush x:Name="Separator2Brush" Color="#E2E8F0"/>
                    </Border.Background>
                </Border>

                <!-- Paste button -->
                <Button x:Name="PasteButton"
                        Content="Paste"
                        Style="{StaticResource ActionBtn}"
                        Click="PasteButton_Click"
                        Visibility="Collapsed"/>

                <!-- Dynamic action buttons -->
                <StackPanel x:Name="ActionPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"/>

                <!-- Result feedback -->
                <TextBlock x:Name="ResultText"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="13"
                           FontWeight="Medium"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"
                           Opacity="0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Border>
</Window>
