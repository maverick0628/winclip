<Window x:Class="WinClip.UI.AIPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinClip AI"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Focusable="False">

    <Border Margin="12">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="6" BlurRadius="20" Color="#0F172A" Opacity="0.30" Direction="270"/>
        </Border.Effect>

        <Border x:Name="RootBorder"
                CornerRadius="12"
                Padding="14,12"
                Opacity="0"
                MinWidth="280">
            <Border.Background>
                <SolidColorBrush x:Name="RootBg" Color="#0F172A"/>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush x:Name="RootBorderBrush" Color="#1E293B"/>
            </Border.BorderBrush>
            <Border.BorderThickness>
                <Thickness>1</Thickness>
            </Border.BorderThickness>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Status icon: rotating spinner during processing, ✓ on success, ✕ on error -->
                <Grid Grid.Column="0"
                      Width="28" Height="28"
                      Margin="0,0,12,0"
                      VerticalAlignment="Center">
                    <Border x:Name="IconBg"
                            CornerRadius="6"
                            Background="#1A2DD4BF"/>
                    <TextBlock x:Name="StatusGlyph"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.Foreground>
                            <SolidColorBrush x:Name="GlyphBrush" Color="#2DD4BF"/>
                        </TextBlock.Foreground>
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="GlyphSpin" Angle="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="14"
                               FontWeight="Medium">
                        <TextBlock.Foreground>
                            <SolidColorBrush x:Name="TitleBrush" Color="#E2E8F0"/>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock x:Name="StatusText"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="12"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"
                               MaxWidth="320">
                        <TextBlock.Foreground>
                            <SolidColorBrush x:Name="StatusBrush" Color="#94A3B8"/>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
