{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "WebSearch": {
    "DefaultSearchEngine": "Google"
  },
  "Translate": {
    "TargetLanguage": "en"
  },
  "Update": {
    "AutoCheck": true,
    "CheckIntervalMinutes": 360
  }
}
